/* ============================================================
   TAJIK OPPORTUNITIES
   Professional responsive design
   ============================================================ */

:root {
  --green-950: #052e1b;
  --green-900: #064e2a;
  --green-800: #086b38;
  --green-700: #0a7a40;
  --green-600: #0b8f4d;
  --green-500: #16a05d;

  --gold-600: #c58b16;
  --gold-500: #d6a329;
  --gold-400: #e7bd4f;
  --gold-300: #f2d37a;

  --white: #ffffff;
  --gray-50: #f8faf9;
  --gray-100: #f1f5f3;
  --gray-200: #e2e8e5;
  --gray-300: #cbd5d0;
  --gray-400: #94a39b;
  --gray-500: #64746b;
  --gray-600: #47554d;
  --gray-700: #344039;
  --gray-800: #202923;
  --gray-900: #111713;

  --danger: #dc3545;
  --danger-dark: #b42333;
  --warning: #d98b00;
  --success: #16834c;
  --info: #1769aa;

  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.09);
  --shadow-lg: 0 18px 45px rgba(0, 0, 0, 0.13);

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 22px;
  --radius-xl: 30px;

  --container: 1180px;

  --transition: 180ms ease;
}

/* ============================================================
   RESET
   ============================================================ */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  min-height: 100vh;
  background: var(--gray-50);
  color: var(--gray-800);
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body.no-scroll {
  overflow: hidden;
}

img {
  display: block;
  max-width: 100%;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

ul,
ol {
  list-style: none;
}

/* ============================================================
   ACCESSIBILITY
   ============================================================ */

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

:focus-visible {
  outline: 3px solid rgba(214, 163, 41, 0.65);
  outline-offset: 3px;
}

/* ============================================================
   LAYOUT
   ============================================================ */

.container {
  width: min(calc(100% - 32px), var(--container));
  margin: 0 auto;
}

.page {
  min-height: calc(100vh - 180px);
}

.section {
  padding: 72px 0;
}

.section-sm {
  padding: 40px 0;
}

/* ============================================================
   HEADER
   ============================================================ */

.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid var(--gray-200);
  backdrop-filter: blur(14px);
}

.header-inner {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.brand-logo {
  width: 50px;
  height: 50px;
  object-fit: contain;
  border-radius: 50%;
  flex: 0 0 auto;
}

.brand-text {
  min-width: 0;
}

.brand-name {
  color: var(--green-900);
  font-size: 1.05rem;
  font-weight: 850;
  line-height: 1.15;
  letter-spacing: -0.02em;
}

.brand-subtitle {
  margin-top: 2px;
  color: var(--gray-500);
  font-size: 0.76rem;
  line-height: 1.2;
}

.site-nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
}

.site-nav a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 13px;
  border-radius: 10px;
  color: var(--gray-700);
  font-size: 0.92rem;
  font-weight: 650;
  transition:
    background var(--transition),
    color var(--transition),
    transform var(--transition);
}

.site-nav a:hover {
  background: var(--gray-100);
  color: var(--green-800);
}

.site-nav a.active {
  background: rgba(8, 107, 56, 0.09);
  color: var(--green-800);
}

.nav-telegram {
  background: var(--green-800) !important;
  color: var(--white) !important;
}

.nav-telegram:hover {
  background: var(--green-900) !important;
  transform: translateY(-1px);
}

/* ============================================================
   MOBILE NAV
   ============================================================ */

.mobile-menu-button {
  display: none;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--gray-200);
  border-radius: 10px;
  background: var(--white);
  color: var(--gray-800);
}

.mobile-menu-button span,
.mobile-menu-button span::before,
.mobile-menu-button span::after {
  display: block;
  width: 20px;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
}

.mobile-menu-button span {
  position: relative;
}

.mobile-menu-button span::before,
.mobile-menu-button span::after {
  position: absolute;
  left: 0;
  content: "";
}

.mobile-menu-button span::before {
  top: -7px;
}

.mobile-menu-button span::after {
  top: 7px;
}

/* ============================================================
   HERO
   ============================================================ */

.hero {
  position: relative;
  overflow: hidden;
  padding: 86px 0 78px;
  background:
    radial-gradient(
      circle at 15% 20%,
      rgba(214, 163, 41, 0.14),
      transparent 28%
    ),
    radial-gradient(
      circle at 85% 10%,
      rgba(22, 160, 93, 0.18),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      var(--green-950),
      var(--green-900) 52%,
      var(--green-800)
    );
  color: var(--white);
}

.hero::before {
  position: absolute;
  inset: 0;
  content: "";
  opacity: 0.12;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
  background-size: 36px 36px;
  pointer-events: none;
}

.hero-inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
  align-items: center;
  gap: 50px;
}

.hero-content {
  max-width: 760px;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 20px;
  padding: 8px 13px;
  border: 1px solid rgba(231, 189, 79, 0.4);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.07);
  color: var(--gold-300);
  font-size: 0.82rem;
  font-weight: 750;
}

.hero h1 {
  max-width: 850px;
  font-size: clamp(2.2rem, 5vw, 4.5rem);
  font-weight: 900;
  line-height: 1.04;
  letter-spacing: -0.045em;
}

.hero h1 span {
  color: var(--gold-400);
}

.hero-description {
  max-width: 700px;
  margin-top: 22px;
  color: rgba(255, 255, 255, 0.84);
  font-size: clamp(1rem, 1.8vw, 1.2rem);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.hero-side {
  display: flex;
  justify-content: center;
}

.hero-logo-card {
  width: min(100%, 330px);
  padding: 28px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: var(--radius-xl);
  background: rgba(255, 255, 255, 0.07);
  box-shadow: var(--shadow-lg);
  backdrop-filter: blur(12px);
}

.hero-logo-card img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: contain;
  border-radius: 20px;
}

/* ============================================================
   BUTTONS
   ============================================================ */

.btn {
  min-height: 46px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 18px;
  border: 1px solid transparent;
  border-radius: 11px;
  font-weight: 750;
  font-size: 0.93rem;
  transition:
    transform var(--transition),
    box-shadow var(--transition),
    background var(--transition),
    border-color var(--transition),
    color var(--transition);
}

.btn:hover {
  transform: translateY(-1px);
}

.btn:disabled {
  cursor: not-allowed;
  opacity: 0.6;
  transform: none;
}

.btn-primary {
  background: var(--green-700);
  color: var(--white);
  box-shadow: 0 6px 18px rgba(8, 107, 56, 0.18);
}

.btn-primary:hover {
  background: var(--green-800);
}

.btn-gold {
  background: var(--gold-500);
  color: var(--gray-900);
  box-shadow: 0 6px 18px rgba(197, 139, 22, 0.2);
}

.btn-gold:hover {
  background: var(--gold-400);
}

.btn-outline {
  border-color: var(--gray-300);
  background: var(--white);
  color: var(--gray-700);
}

.btn-outline:hover {
  border-color: var(--green-600);
  color: var(--green-800);
}

.hero .btn-outline {
  border-color: rgba(255, 255, 255, 0.25);
  background: rgba(255, 255, 255, 0.07);
  color: var(--white);
}

.hero .btn-outline:hover {
  background: rgba(255, 255, 255, 0.13);
}

.btn-danger {
  background: var(--danger);
  color: var(--white);
}

.btn-danger:hover {
  background: var(--danger-dark);
}

.btn-success {
  background: var(--success);
  color: var(--white);
}

.btn-sm {
  min-height: 38px;
  padding: 0 13px;
  border-radius: 9px;
  font-size: 0.84rem;
}

/* ============================================================
   SECTION HEADINGS
   ============================================================ */

.section-header {
  margin-bottom: 30px;
}

.section-header.center {
  text-align: center;
}

.section-label {
  margin-bottom: 8px;
  color: var(--green-700);
  font-size: 0.78rem;
  font-weight: 850;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.section-title {
  color: var(--gray-900);
  font-size: clamp(1.65rem, 3vw, 2.5rem);
  font-weight: 850;
  line-height: 1.15;
  letter-spacing: -0.03em;
}

.section-description {
  max-width: 720px;
  margin-top: 10px;
  color: var(--gray-500);
}

/* ============================================================
   FILTERS
   ============================================================ */

.filters-section {
  padding: 38px 0 20px;
}

.filters-panel {
  padding: 18px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-lg);
  background: var(--white);
  box-shadow: var(--shadow-sm);
}

.search-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12px;
}

.input,
.textarea,
.select {
  width: 100%;
  border: 1px solid var(--gray-300);
  border-radius: 11px;
  background: var(--white);
  color: var(--gray-900);
  transition:
    border-color var(--transition),
    box-shadow var(--transition);
}

.input,
.select {
  min-height: 46px;
  padding: 0 14px;
}

.textarea {
  min-height: 150px;
  padding: 13px 14px;
  resize: vertical;
}

.input::placeholder,
.textarea::placeholder {
  color: var(--gray-400);
}

.input:focus,
.textarea:focus,
.select:focus {
  border-color: var(--green-600);
  box-shadow: 0 0 0 4px rgba(22, 160, 93, 0.1);
  outline: none;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 15px;
}

.category-chip {
  min-height: 36px;
  padding: 0 13px;
  border: 1px solid var(--gray-200);
  border-radius: 999px;
  background: var(--gray-50);
  color: var(--gray-600);
  font-size: 0.83rem;
  font-weight: 700;
  transition:
    background var(--transition),
    color var(--transition),
    border-color var(--transition);
}

.category-chip:hover {
  border-color: rgba(8, 107, 56, 0.25);
  background: rgba(8, 107, 56, 0.06);
  color: var(--green-800);
}

.category-chip.active {
  border-color: var(--green-700);
  background: var(--green-700);
  color: var(--white);
}

.sort-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-top: 16px;
}

.results-info {
  color: var(--gray-500);
  font-size: 0.87rem;
}

/* ============================================================
   POSTS GRID
   ============================================================ */

.posts-section {
  padding: 24px 0 78px;
}

.posts-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.post-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-lg);
  background: var(--white);
  box-shadow: var(--shadow-sm);
  transition:
    transform 220ms ease,
    box-shadow 220ms ease,
    border-color 220ms ease;
}

.post-card:hover {
  border-color: rgba(8, 107, 56, 0.18);
  box-shadow: var(--shadow-md);
  transform: translateY(-4px);
}

.post-card-link {
  display: block;
  height: 100%;
}

.post-card-image {
  width: 100%;
  height: 210px;
  object-fit: cover;
  background: var(--gray-100);
}

.post-card-body {
  display: flex;
  flex-direction: column;
  min-height: 230px;
  padding: 19px;
}

.post-card-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

.post-category {
  display: inline-flex;
  align-items: center;
  min-height: 27px;
  padding: 0 9px;
  border-radius: 999px;
  background: rgba(8, 107, 56, 0.09);
  color: var(--green-800);
  font-size: 0.74rem;
  font-weight: 800;
}

.post-date {
  color: var(--gray-400);
  font-size: 0.76rem;
}

.post-card-title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--gray-900);
  font-size: 1.08rem;
  font-weight: 800;
  line-height: 1.3;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.post-card-excerpt {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10px;
  color: var(--gray-500);
  font-size: 0.88rem;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.post-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: auto;
  padding-top: 17px;
  border-top: 1px solid var(--gray-100);
}

.post-author {
  overflow: hidden;
  color: var(--gray-500);
  font-size: 0.77rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.read-more {
  color: var(--green-700);
  font-size: 0.8rem;
  font-weight: 800;
}

/* ============================================================
   STATES
   ============================================================ */

.state-box {
  padding: 60px 20px;
  border: 1px dashed var(--gray-300);
  border-radius: var(--radius-lg);
  background: var(--white);
  text-align: center;
}

.state-icon {
  margin-bottom: 12px;
  font-size: 2rem;
}

.state-box h2,
.state-box h3 {
  color: var(--gray-900);
  font-size: 1.2rem;
  font-weight: 800;
}

.state-box p {
  max-width: 520px;
  margin: 8px auto 0;
  color: var(--gray-500);
}

.state-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 20px;
}

/* ============================================================
   FORMS
   ============================================================ */

.form-container {
  max-width: 820px;
  margin: 0 auto;
}

.form-card {
  padding: 28px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-lg);
  background: var(--white);
  box-shadow: var(--shadow-sm);
}

.form-group {
  margin-bottom: 20px;
}

.form-label {
  display: block;
  margin-bottom: 7px;
  color: var(--gray-800);
  font-size: 0.88rem;
  font-weight: 750;
}

.form-help {
  margin-top: 6px;
  color: var(--gray-400);
  font-size: 0.76rem;
}

.form-error {
  margin-top: 6px;
  color: var(--danger);
  font-size: 0.78rem;
}

.form-counter {
  margin-top: 5px;
  color: var(--gray-400);
  font-size: 0.74rem;
  text-align: right;
}

.form-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 25px;
}

.form-message {
  margin-top: 15px;
  padding: 12px 14px;
  border-radius: 10px;
  font-size: 0.86rem;
}

.form-message.success {
  border: 1px solid rgba(22, 131, 76, 0.2);
  background: rgba(22, 131, 76, 0.08);
  color: var(--success);
}

.form-message.error {
  border: 1px solid rgba(220, 53, 69, 0.2);
  background: rgba(220, 53, 69, 0.08);
  color: var(--danger-dark);
}

.url-preview {
  display: none;
  overflow: hidden;
  margin-top: 10px;
  border: 1px solid var(--gray-200);
  border-radius: 10px;
}

.url-preview.show {
  display: block;
}

.url-preview img {
  width: 100%;
  max-height: 260px;
  object-fit: contain;
  background: var(--gray-100);
}

/* ============================================================
   POST PAGE
   ============================================================ */

.post-page {
  padding: 55px 0 80px;
}

.post-detail {
  max-width: 900px;
  margin: 0 auto;
}

.post-detail-header {
  margin-bottom: 28px;
}

.post-detail-category {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 0 10px;
  border-radius: 999px;
  background: rgba(8, 107, 56, 0.09);
  color: var(--green-800);
  font-size: 0.78rem;
  font-weight: 800;
}

.post-detail-title {
  margin-top: 13px;
  color: var(--gray-900);
  font-size: clamp(2rem, 5vw, 3.6rem);
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: -0.04em;
}

.post-detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 16px;
  margin-top: 14px;
  color: var(--gray-500);
  font-size: 0.84rem;
}

.post-detail-image {
  width: 100%;
  max-height: 600px;
  margin-bottom: 28px;
  border-radius: var(--radius-lg);
  object-fit: cover;
  background: var(--gray-100);
}

.post-detail-content {
  color: var(--gray-700);
  font-size: 1.03rem;
  line-height: 1.85;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.post-detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 32px;
  padding-top: 22px;
  border-top: 1px solid var(--gray-200);
}

/* ============================================================
   CTA
   ============================================================ */

.cta-section {
  padding: 20px 0 75px;
}

.cta-card {
  position: relative;
  overflow: hidden;
  padding: 42px;
  border-radius: var(--radius-xl);
  background:
    radial-gradient(
      circle at 90% 20%,
      rgba(231, 189, 79, 0.16),
      transparent 28%
    ),
    linear-gradient(135deg, var(--green-900), var(--green-700));
  color: var(--white);
}

.cta-card h2 {
  max-width: 720px;
  font-size: clamp(1.7rem, 3vw, 2.6rem);
  font-weight: 850;
  line-height: 1.15;
}

.cta-card p {
  max-width: 700px;
  margin-top: 10px;
  color: rgba(255, 255, 255, 0.8);
}

.cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 22px;
}

/* ============================================================
   TELEGRAM
   ============================================================ */

.telegram-section {
  padding: 0 0 70px;
}

.telegram-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  padding: 25px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-lg);
  background: var(--white);
  box-shadow: var(--shadow-sm);
}

.telegram-content h2 {
  color: var(--gray-900);
  font-size: 1.25rem;
  font-weight: 820;
}

.telegram-content p {
  margin-top: 5px;
  color: var(--gray-500);
  font-size: 0.87rem;
}

.telegram-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

/* ============================================================
   ADMIN
   ============================================================ */

.admin-page {
  padding: 45px 0 80px;
}

.admin-container {
  max-width: 1180px;
  margin: 0 auto;
}

.admin-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 25px;
}

.admin-title {
  color: var(--gray-900);
  font-size: clamp(1.7rem, 4vw, 2.5rem);
  font-weight: 900;
  line-height: 1.1;
}

.admin-subtitle {
  margin-top: 7px;
  color: var(--gray-500);
}

.admin-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 22px;
}

.stat-card {
  padding: 20px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-md);
  background: var(--white);
  box-shadow: var(--shadow-sm);
}

.stat-label {
  color: var(--gray-500);
  font-size: 0.78rem;
  font-weight: 700;
}

.stat-value {
  margin-top: 5px;
  color: var(--gray-900);
  font-size: 1.8rem;
  font-weight: 900;
}

.admin-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 18px;
}

.admin-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.admin-filter {
  min-height: 37px;
  padding: 0 12px;
  border: 1px solid var(--gray-200);
  border-radius: 9px;
  background: var(--white);
  color: var(--gray-600);
  font-size: 0.8rem;
  font-weight: 750;
}

.admin-filter.active {
  border-color: var(--green-700);
  background: var(--green-700);
  color: var(--white);
}

.submissions-list {
  display: grid;
  gap: 12px;
}

.submission-item {
  padding: 18px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-md);
  background: var(--white);
  box-shadow: var(--shadow-sm);
}

.submission-item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 15px;
}

.submission-item-title {
  color: var(--gray-900);
  font-size: 1rem;
  font-weight: 800;
}

.submission-item-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 7px 12px;
  margin-top: 6px;
  color: var(--gray-500);
  font-size: 0.77rem;
}

.submission-item-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 14px;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  min-height: 27px;
  padding: 0 9px;
  border-radius: 999px;
  font-size: 0.73rem;
  font-weight: 800;
}

.status-pending {
  background: rgba(217, 139, 0, 0.11);
  color: var(--warning);
}

.status-approved {
  background: rgba(22, 131, 76, 0.1);
  color: var(--success);
}

.status-rejected {
  background: rgba(220, 53, 69, 0.1);
  color: var(--danger);
}

/* ============================================================
   MODALS
   ============================================================ */

.modal {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(4, 12, 8, 0.65);
}

.modal.show {
  display: flex;
}

.modal-dialog {
  width: min(100%, 720px);
  max-height: min(850px, calc(100vh - 40px));
  overflow: auto;
  border-radius: var(--radius-lg);
  background: var(--white);
  box-shadow: var(--shadow-lg);
}

.modal-header {
  position: sticky;
  top: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 17px 20px;
  border-bottom: 1px solid var(--gray-200);
  background: var(--white);
}

.modal-title {
  color: var(--gray-900);
  font-size: 1.1rem;
  font-weight: 850;
}

.modal-close {
  width: 38px;
  height: 38px;
  border: 1px solid var(--gray-200);
  border-radius: 9px;
  background: var(--white);
  color: var(--gray-600);
  font-size: 1.2rem;
}

.modal-body {
  padding: 20px;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 9px;
  padding: 15px 20px;
  border-top: 1px solid var(--gray-200);
}

/* ============================================================
   SUCCESS / TRACKING
   ============================================================ */

.success-card {
  max-width: 680px;
  margin: 0 auto;
  padding: 35px;
  border: 1px solid rgba(22, 131, 76, 0.18);
  border-radius: var(--radius-lg);
  background: var(--white);
  text-align: center;
  box-shadow: var(--shadow-sm);
}

.success-icon {
  font-size: 3rem;
}

.tracking-code {
  display: inline-flex;
  align-items: center;
  margin: 17px 0;
  padding: 12px 16px;
  border: 1px dashed var(--green-600);
  border-radius: 10px;
  background: rgba(22, 160, 93, 0.06);
  color: var(--green-800);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 1rem;
  font-weight: 850;
  letter-spacing: 0.06em;
}

/* ============================================================
   TOAST
   ============================================================ */

.toast {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 5000;
  width: min(380px, calc(100vw - 40px));
  padding: 14px 16px;
  border: 1px solid var(--gray-200);
  border-radius: 12px;
  background: var(--white);
  color: var(--gray-800);
  box-shadow: var(--shadow-lg);
  font-size: 0.86rem;
  font-weight: 650;
  opacity: 0;
  transform: translateY(12px);
  pointer-events: none;
  transition:
    opacity 180ms ease,
    transform 180ms ease;
}

.toast.show {
  opacity: 1;
  transform: translateY(0);
}

.toast.success {
  border-color: rgba(22, 131, 76, 0.25);
}

.toast.error {
  border-color: rgba(220, 53, 69, 0.25);
}

/* ============================================================
   FOOTER
   ============================================================ */

.site-footer {
  margin-top: auto;
  padding: 45px 0 25px;
  background: var(--green-950);
  color: rgba(255, 255, 255, 0.8);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr 0.8fr;
  gap: 40px;
}

.footer-brand {
  display: flex;
  align-items: flex-start;
  gap: 13px;
}

.footer-logo {
  width: 54px;
  height: 54px;
  flex: 0 0 auto;
  border-radius: 50%;
  object-fit: contain;
}

.footer-brand h2 {
  color: var(--white);
  font-size: 1.05rem;
  font-weight: 850;
}

.footer-brand p {
  max-width: 420px;
  margin-top: 6px;
  color: rgba(255, 255, 255, 0.58);
  font-size: 0.81rem;
}

.footer-title {
  margin-bottom: 11px;
  color: var(--white);
  font-size: 0.86rem;
  font-weight: 800;
}

.footer-links {
  display: grid;
  gap: 7px;
}

.footer-links a {
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.82rem;
  transition: color var(--transition);
}

.footer-links a:hover {
  color: var(--gold-300);
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-top: 35px;
  padding-top: 18px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.42);
  font-size: 0.74rem;
}

/* ============================================================
   UTILITY
   ============================================================ */

.hidden {
  display: none !important;
}

.text-center {
  text-align: center;
}

.text-muted {
  color: var(--gray-500);
}

.mt-1 {
  margin-top: 8px;
}

.mt-2 {
  margin-top: 16px;
}

.mt-3 {
  margin-top: 24px;
}

.mb-1 {
  margin-bottom: 8px;
}

.mb-2 {
  margin-bottom: 16px;
}

.mb-3 {
  margin-bottom: 24px;
}

/* ============================================================
   RESPONSIVE — TABLET
   ============================================================ */

@media (max-width: 980px) {
  .hero-inner {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .hero-side {
    justify-content: flex-start;
  }

  .hero-logo-card {
    width: 230px;
  }

  .posts-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .admin-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .footer-brand {
    grid-column: 1 / -1;
  }
}

/* ============================================================
   RESPONSIVE — MOBILE
   ============================================================ */

@media (max-width: 760px) {
  .container {
    width: min(calc(100% - 22px), var(--container));
  }

  .header-inner {
    min-height: 68px;
  }

  .brand-logo {
    width: 44px;
    height: 44px;
  }

  .brand-name {
    font-size: 0.94rem;
  }

  .brand-subtitle {
    display: none;
  }

  .mobile-menu-button {
    display: inline-flex;
  }

  .site-nav {
    position: absolute;
    top: calc(100% + 1px);
    right: 11px;
    left: 11px;
    display: none;
    flex-direction: column;
    align-items: stretch;
    padding: 10px;
    border: 1px solid var(--gray-200);
    border-radius: 14px;
    background: var(--white);
    box-shadow: var(--shadow-md);
  }

  .site-nav.open {
    display: flex;
  }

  .site-nav a {
    justify-content: flex-start;
    min-height: 44px;
    padding: 0 12px;
  }

  .hero {
    padding: 58px 0 55px;
  }

  .hero h1 {
    font-size: clamp(2rem, 11vw, 3rem);
  }

  .hero-description {
    font-size: 0.96rem;
  }

  .hero-actions,
  .cta-actions,
  .form-actions {
    flex-direction: column;
  }

  .hero-actions .btn,
  .cta-actions .btn,
  .form-actions .btn {
    width: 100%;
  }

  .hero-side {
    display: none;
  }

  .section {
    padding: 48px 0;
  }

  .filters-section {
    padding-top: 25px;
  }

  .search-row {
    grid-template-columns: 1fr;
  }

  .sort-row {
    align-items: stretch;
    flex-direction: column;
  }

  .sort-row .select {
    width: 100%;
  }

  .posts-grid {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .post-card-image {
    height: 190px;
  }

  .post-card-body {
    min-height: 210px;
  }

  .form-card {
    padding: 19px;
  }

  .post-page {
    padding: 35px 0 60px;
  }

  .post-detail-title {
    font-size: clamp(1.8rem, 9vw, 2.7rem);
  }

  .post-detail-content {
    font-size: 0.96rem;
  }

  .cta-card {
    padding: 28px 20px;
    border-radius: 20px;
  }

  .telegram-card {
    align-items: stretch;
    flex-direction: column;
    padding: 20px;
  }

  .telegram-actions {
    flex-direction: column;
  }

  .telegram-actions .btn {
    width: 100%;
  }

  .admin-page {
    padding: 30px 0 55px;
  }

  .admin-header {
    flex-direction: column;
  }

  .admin-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .admin-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-filters {
    width: 100%;
  }

  .admin-filter {
    flex: 1 1 auto;
  }

  .submission-item-header {
    flex-direction: column;
  }

  .submission-item-actions .btn {
    flex: 1 1 auto;
  }

  .modal {
    padding: 10px;
  }

  .modal-dialog {
    max-height: calc(100vh - 20px);
    border-radius: 16px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .footer-brand {
    grid-column: auto;
  }

  .footer-bottom {
    flex-direction: column;
  }
}

/* ============================================================
   RESPONSIVE — SMALL PHONES
   ============================================================ */

@media (max-width: 420px) {
  .brand-name {
    font-size: 0.86rem;
  }

  .hero h1 {
    font-size: 2rem;
  }

  .category-list {
    gap: 6px;
  }

  .category-chip {
    font-size: 0.76rem;
    padding: 0 10px;
  }

  .admin-stats {
    gap: 9px;
  }

  .stat-card {
    padding: 14px;
  }

  .stat-value {
    font-size: 1.45rem;
  }

  .success-card {
    padding: 25px 18px;
  }
}

/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
  }
