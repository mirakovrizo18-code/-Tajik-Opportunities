  function createRoot(container) {
    if (!container) {
      container =
        document.querySelector(
          "[data-to-notification-settings]"
        );
    }

    if (!container) {
      container =
        document.createElement("section");

      container.dataset.toNotificationSettings =
        "true";

      document.body.appendChild(container);
    }

    container.classList.add(
      "to-notification-settings"
    );

    return container;
  }

  function modeLabel(mode) {
    switch (mode) {
      case CONFIG.modes.ALLOW:
        return "Разрешено";

      case CONFIG.modes.DENY:
        return "Запрещено";

      default:
        return "Наследовать";
    }
  }

  function modeClass(mode) {
    switch (mode) {
      case CONFIG.modes.ALLOW:
        return "is-allow";

      case CONFIG.modes.DENY:
        return "is-deny";

      default:
        return "is-inherit";
    }
  }

  function renderModeSelect(
    categoryId,
    eventId,
    channel,
    value
  ) {
    const locked =
      !canChange(
        categoryId,
        eventId,
        channel
      );

    return `
      <select
        class="to-notification-setting-select ${modeClass(value)}"
        data-setting-channel="${escapeHtml(channel)}"
        data-category-id="${escapeHtml(categoryId)}"
        data-event-id="${escapeHtml(eventId)}"
        ${locked ? "disabled" : ""}
      >
        <option value="inherit" ${
          value === "inherit" ? "selected" : ""
        }>Наследовать</option>

        <option value="allow" ${
          value === "allow" ? "selected" : ""
        }>Разрешено</option>

        <option value="deny" ${
          value === "deny" ? "selected" : ""
        }>Запрещено</option>
      </select>
    `;
  }

  function renderChannelLabel(channel) {
    const labels = {
      in_app: "В приложении",
      push: "Push",
      sound: "Звук",
      vibration: "Вибрация",
      badge: "Badge",
      email: "Email",
      system_chat: "System Chat"
    };

    return labels[channel] || channel;
  }

  function renderCategory(
    category
  ) {
    const settings =
      state.current.categories[category.id];

    if (!settings) return "";

    const eventsHtml =
      category.events.map(function (eventId) {
        const event =
          settings.events[eventId];

        const channelHtml =
