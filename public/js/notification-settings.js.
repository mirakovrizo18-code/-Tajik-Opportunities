  function updateSelectClass(select) {
    select.classList.remove(
      "is-allow",
      "is-deny",
      "is-inherit"
    );

    select.classList.add(
      modeClass(select.value)
    );
  }

  function bindUI(root) {
    root.querySelectorAll(
      "[data-setting-channel]"
    ).forEach(function (select) {
      select.addEventListener(
        "change",
        function () {
          const categoryId =
            select.dataset.categoryId;

          const eventId =
            select.dataset.eventId;

          const channel =
            select.dataset.settingChannel;

          setChannel(
            categoryId,
            eventId,
            channel,
            select.value
          );

          updateSelectClass(select);
          updateFooter(root);
        }
      );
    });

    root.querySelectorAll(
      "[data-category-enabled]"
    ).forEach(function (input) {
      input.addEventListener(
        "change",
        function () {
          setCategoryEnabled(
            input.dataset.categoryId,
            input.checked
          );

          updateFooter(root);
        }
      );
    });

    root.querySelectorAll(
      "[data-event-enabled]"
    ).forEach(function (input) {
      input.addEventListener(
        "change",
        function () {
          setEventEnabled(
            input.dataset.categoryId,
            input.dataset.eventId,
            input.checked
          );

          updateFooter(root);
        }
      );
    });

    root.querySelector(
      "[data-global-enabled]"
    )?.addEventListener(
      "change",
      function (event) {
        setGlobalEnabled(
          event.target.checked
        );

        updateFooter(root);
      }
    );

    root.querySelectorAll(
      "[data-global-channel]"
    ).forEach(function (input) {
      input.addEventListener(
        "change",
        function () {
          const channel =
            input.dataset.globalChannel;

          state.current.global[channel] =
            input.checked;

          markDirty();

          updateFooter(root);
        }
      );
    });

    root.querySelector(
      "[data-quiet-hours-enabled]"
    )?.addEventListener(
      "change",
      function (event) {
        state.current.global.quiet_hours.enabled =
          event.target.checked;

        markDirty();
      }
    );

    root.querySelector(
      "[data-quiet-hours-start]"
    )?.addEventListener(
      "change",
      function (event) {
        state.current.global.quiet_hours.start =
          event.target.value;

        markDirty();
      }
    );

    root.querySelector(
      "[data-quiet-hours-end]"
    )?.addEventListener(
      "change",
      function (event) {
        state.current.global.quiet_hours.end =
          event.target.value;

        markDirty();
      }
    );

    root.querySelectorAll(
      "[data-notification-action]"
    ).forEach(function (button) {
      button.addEventListener(
        "click",
        async function () {
          const action =
            button.dataset.notificationAction;

          if (action === "allow-all") {
            allowAll();
            render(root);
            return;
          }

          if (action === "inherit-all") {
            inheritAll();
            render(root);
            return;
          }

          if (action === "deny-all") {
            denyAll();
            render(root);
            return;
          }

          if (action === "save") {
            try {
              button.disabled = true;

              await save();

              render(root);
            } catch (error) {
              console.error(
                "[TO NotificationSettings]",
                error
              );

              button.disabled = false;

              showError(
                root,
                error.message
              );
            }
          }
        }
      );
    });
  }

  function updateFooter(root) {
    const footer =
      root.querySelector(
        ".to-notification-settings-footer span"
      );

    if (!footer) return;

    footer.textContent =
      state.dirty
        ? "● Есть несохранённые изменения"
        : "✓ Все изменения сохранены";

    footer.classList.toggle(
      "is-dirty",
      state.dirty
    );
  }

  function showError(
    root,
    message
  ) {
    let box =
      root.querySelector(
        ".to-notification-settings-error"
      );

    if (!box) {
      box =
        document.createElement("div");

      box.className =
        "to-notification-settings-error";

      root.prepend(box);
    }

    box.textContent =
      message ||
      "Произошла ошибка.";

    box.style.display = "block";

    window.setTimeout(function () {
      box.style.display = "none";
    }, 6000);
  }

