            const mode =
              event[channel] ||
              CONFIG.modes.INHERIT;

            return `
              <div class="to-notification-channel">
                <div class="to-notification-channel-name">
                  ${escapeHtml(
                    renderChannelLabel(channel)
                  )}
                </div>

                ${renderModeSelect(
                  category.id,
                  eventId,
                  channel,
                  mode
                )}
              </div>
