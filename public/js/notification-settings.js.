  function setMode(mode) {
    if (
      ![
        "participant",
        "admin",
        "superadmin"
      ].includes(mode)
    ) {
      return false;
    }

    state.mode = mode;

    emit("mode-changed", {
      mode
    });

    return true;
  }

  function markDirty() {
    state.dirty = true;

    saveLocal();

    emit("changed");
  }

  function setGlobalEnabled(enabled) {
    state.current.global.enabled =
      Boolean(enabled);

    markDirty();
  }

  function setCategoryEnabled(
    categoryId,
    enabled
  ) {
    if (!state.current.categories?.[categoryId]) {
      return false;
    }

    state.current.categories[categoryId].enabled =
      Boolean(enabled);

    markDirty();

    return true;
  }

  function setEventEnabled(
    categoryId,
    eventId,
    enabled
  ) {
    const event =
      getRawEventSetting(
        state.current,
        categoryId,
        eventId
      );

    if (!event) return false;

    event.enabled =
      Boolean(enabled);

    markDirty();

    return true;
  }

  function setChannel(
    categoryId,
    eventId,
    channel,
    mode
  ) {
    if (!CONFIG.channels.includes(channel)) {
      return false;
    }

    if (!canChange(
      categoryId,
      eventId,
      channel
    )) {
      return false;
    }

    const event =
      getRawEventSetting(
        state.current,
        categoryId,
        eventId
      );

    if (!event) return false;

    event[channel] =
      normalizeMode(mode);

    markDirty();

    emit("channel-changed", {
      categoryId,
      eventId,
      channel,
      mode: event[channel]
    });

    return true;
  }

  function setCategoryChannel(
    categoryId,
