      if (!raw) return null;

      const parsed = JSON.parse(raw);

      return parsed || null;
    } catch {
      return null;
    }
  }

  /* ==========================================================
     API
     ========================================================== */

  async function request(
    url,
    options
  ) {
    const opts = Object.assign(
      {
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json"
        }
      },
      options || {}
    );

    const response = await fetch(url, opts);

    let data = null;

    try {
      data = await response.json();
    } catch {
      data = null;
    }

    if (!response.ok) {
      const message =
        data?.message ||
        data?.error ||
        "Ошибка запроса настроек уведомлений.";

      const error = new Error(message);
      error.status = response.status;
      error.data = data;

      throw error;
    }

    return data;
  }

  async function load(options) {
    const opts = options || {};

    emit("loading");

    try {
      const local =
        opts.useLocal === false
          ? null
          : loadLocal();

      if (local?.current) {
        state.current =
          normalizeSettings(local.current);
      }

      const data = await request(CONFIG.api.get, {
        method: "GET"
      });

      state.global =
        normalizeSettings(
          data?.global ||
          data?.settings?.global ||
          createDefaultSettings()
        );

      state.current =
        normalizeSettings(
          data?.current ||
          data?.settings ||
          state.current
        );

      state.admin =
        normalizeSettings(
          data?.admin ||
          {}
        );

      state.forced =
        normalizeSettings(
          data?.forced ||
          {}
        );

      state.metadata = Object.assign(
        {},
        state.metadata,
        data?.metadata || {}
      );

      state.loaded = true;
      state.dirty = false;

      saveLocal();

      emit("loaded", data);

      return data;
    } catch (error) {
      state.loaded = Boolean(state.current);

      emit("error", {
        action: "load",
        error
      });

      throw error;
    }
  }

  async function save(options) {
    const opts = options || {};

    if (state.saving) {
      return false;
    }

    state.saving = true;

    emit("saving");

    try {
      const payload = {
        settings: state.current,
        participant_id: state.participantId,
        mode: state.mode,
        metadata: state.metadata
      };

      const data = await request(
        opts.url || CONFIG.api.save,
        {
          method: "PUT",
          body: JSON.stringify(payload)
        }
      );

      if (data?.settings) {
        state.current =
          normalizeSettings(data.settings);
      }

      state.metadata = Object.assign(
        {},
        state.metadata,
        data?.metadata || {},
        {
          updatedAt:
            data?.metadata?.updatedAt ||
            new Date().toISOString()
        }
      );

      state.dirty = false;

      saveLocal();

      emit("saved", data);

      return data;
    } catch (error) {
      emit("error", {
        action: "save",
        error
      });

      throw error;
    } finally {
      state.saving = false;
    }
  }

  async function saveGlobal(settings) {
    const payload =
      settings || state.global;

    return request(CONFIG.api.global, {
      method: "PUT",
      body: JSON.stringify({
        settings: payload
      })
