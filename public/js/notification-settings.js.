          type="button"
          data-admin-action="deny-all"
        >
          🚫 Запретить всё
        </button>

      </div>

      <div class="to-notification-admin-participant">

        <label>
          ID участника
          <input
            type="text"
            data-admin-participant-id
            placeholder="participant_id"
          >
        </label>

        <button
          type="button"
          data-admin-action="load-participant"
        >
          Загрузить настройки
        </button>

      </div>

      <div
        class="to-notification-admin-content"
        data-admin-content
      ></div>
    `;

    const modeSelect =
      root.querySelector(
        "[data-admin-mode]"
      );

    modeSelect.value =
      state.mode;

    modeSelect.addEventListener(
      "change",
      function () {
        setMode(
          modeSelect.value
        );
      }
    );

    root.querySelectorAll(
      "[data-admin-action]"
    ).forEach(function (button) {
      button.addEventListener(
        "click",
        async function () {
          const action =
            button.dataset.adminAction;

          if (action === "allow-all") {
            allowAll();
            renderAdminControl(root);
            return;
          }

          if (action === "deny-all") {
            denyAll();
            renderAdminControl(root);
            return;
          }

          if (action === "load-participant") {
            const input =
              root.querySelector(
                "[data-admin-participant-id]"
              );

            const id =
              input?.value?.trim();

            if (!id) return;

            try {
              setParticipant(id);

              await load({
                useLocal: false
              });

              render(root);
            } catch (error) {
              showError(
                root,
                error.message
              );
            }

            return;
          }

          if (action === "history") {
            const id =
              state.participantId;

            try {
              const history =
                await loadHistory(id);

              const content =
                root.querySelector(
                  "[data-admin-content]"
                );

              if (!content) return;

              content.innerHTML =
                renderHistory(
                  history
                );
            } catch (error) {
              showError(
                root,
                error.message
              );
            }

            return;
          }

          if (action === "force") {
            const content =
              root.querySelector(
                "[data-admin-content]"
              );

            if (content) {
              content.innerHTML =
                renderForceControls();
            }

            return;
          }

          if (
            action === "global" ||
            action === "participant"
          ) {
            render(root);
          }
        }
      );
    });

    return root;
  }

