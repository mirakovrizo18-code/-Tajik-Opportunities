/* ============================================================
   REQUEST ID
   ============================================================ */

function createRequestId() {
  apiState.requestCounter += 1;

  const random =
    typeof crypto !== "undefined" &&
    typeof crypto.randomUUID === "function"
      ? crypto.randomUUID()
      : `${Date.now()}-${Math.random().toString(36).slice(2)}`;

  return `web-${apiState.requestCounter}-${random}`;
}


/* ============================================================
   URL HELPERS
   ============================================================ */

function normalizePath(path = "") {
  let value = String(path || "").trim();

  if (!value) {
    return "/";
  }

  if (!value.startsWith("/")) {
    value = `/${value}`;
  }

  return value.replace(/\/{2,}/g, "/");
}


function buildUrl(path, query = null) {
  const normalized = normalizePath(path);

  let url;

  if (
    normalized.startsWith("http://") ||
    normalized.startsWith("https://")
  ) {
    url = new URL(normalized);
  } else {
    url = new URL(
      `${API_CONFIG.BASE_URL}${normalized}`,
      window.location.origin
    );
  }

  if (query && typeof query === "object") {
    Object.entries(query).forEach(([key, value]) => {
      if (
        value === undefined ||
        value === null ||
        value === ""
      ) {
        return;
      }

      if (Array.isArray(value)) {
        value.forEach(item => {
          if (
            item !== undefined &&
            item !== null &&
            item !== ""
          ) {
            url.searchParams.append(key, String(item));
          }
        });

        return;
      }

      url.searchParams.set(key, String(value));
    });
  }

  return url.toString();
}


/* ============================================================
   HEADER HELPERS
   ============================================================ */

function createHeaders(options = {}) {
  const headers = new Headers();

  headers.set("Accept", "application/json");

  const method =
    String(options.method || "GET").toUpperCase();

  if (
    options.body !== undefined &&
    options.body !== null &&
    !(options.body instanceof FormData) &&
    !(options.body instanceof Blob) &&
    !(options.body instanceof ArrayBuffer)
  ) {
    headers.set(
      "Content-Type",
      "application/json"
    );
  }

  if (apiState.accessToken) {
    headers.set(
      "Authorization",
      `Bearer ${apiState.accessToken}`
    );
  }

  if (apiState.adminToken) {
    headers.set(
      "X-Admin-Token",
      apiState.adminToken
    );
  }

  if (apiState.csrfToken) {
    headers.set(
      "X-CSRF-Token",
      apiState.csrfToken
    );
  }

  if (apiState.visitorId) {
    headers.set(
      "X-Visitor-ID",
      apiState.visitorId
    );
  }

  if (apiState.sessionId) {
    headers.set(
      "X-Session-ID",
      apiState.sessionId
    );
  }

  headers.set(
    "X-Request-ID",
    createRequestId()
  );

  if (method !== "GET") {
    headers.set(
      "X-Requested-With",
      "XMLHttpRequest"
    );
  }

  if (options.headers) {
    Object.entries(options.headers).forEach(
      ([key, value]) => {
        if (
          value !== undefined &&
          value !== null
        ) {
          headers.set(key, String(value));
        }
      }
    );
  }

  return headers;
}


/* ============================================================
   BODY SERIALIZATION
   ============================================================ */

function prepareBody(body) {
  if (
    body === undefined ||
    body === null
  ) {
    return undefined;
  }

  if (
    body instanceof FormData ||
    body instanceof Blob ||
    body instanceof ArrayBuffer ||
    typeof body === "string"
  ) {
    return body;
  }

  return JSON.stringify(body);
}


/* ============================================================
   RESPONSE PARSING
   ============================================================ */

async function parseResponseBody(response) {
  const contentType =
    response.headers.get("content-type") || "";

  if (response.status === 204) {
    return null;
  }

  if (
    contentType.includes("application/json") ||
    contentType.includes("+json")
  ) {
    try {
      return await response.json();
    } catch {
      return null;
    }
  }

  const text = await response.text();

  if (!text) {
    return null;
  }

  try {
    return JSON.parse(text);
  } catch {
    return text;
  }
}


/* ============================================================
   API RESPONSE NORMALIZATION
   ============================================================ */

function extractData(data) {
  if (
    data &&
    typeof data === "object" &&
    Object.prototype.hasOwnProperty.call(data, "data")
  ) {
    return data.data;
  }

  return data;
}


function extractMessage(data, fallback) {
  if (!data) {
    return fallback;
  }

  if (typeof data === "string") {
    return data || fallback;
  }

  if (typeof data.message === "string") {
    return data.message;
  }

  if (
    data.error &&
    typeof data.error === "object" &&
    typeof data.error.message === "string"
  ) {
    return data.error.message;
  }

  if (typeof data.error === "string") {
    return data.error;
  }

  return fallback;
}


function extractCode(data) {
  if (!data || typeof data !== "object") {
    return "API_ERROR";
  }

  if (typeof data.code === "string") {
    return data.code;
  }

  if (
    data.error &&
    typeof data.error === "object" &&
    typeof data.error.code === "string"
  ) {
    return data.error.code;
  }

  return "API_ERROR";
}


function extractDetails(data) {
  if (!data || typeof data !== "object") {
    return null;
  }

  if (data.details !== undefined) {
    return data.details;
  }

  if (
    data.error &&
    typeof data.error === "object" &&
    data.error.details !== undefined
  ) {
    return data.error.details;
  }

  return null;
}


/* ============================================================
   RETRY
   ============================================================ */

function isRetryableStatus(status) {
  return (
    status === 408 ||
    status === 425 ||
    status === 429 ||
    status >= 500
  );
}


function sleep(ms) {
  return new Promise(resolve =>
    setTimeout(resolve, ms)
  );
}


/* ============================================================
   REQUEST
   ============================================================ */

async function request(path, options = {}) {
  const {
    method = "GET",
    query = null,
    body = undefined,
    timeout = API_CONFIG.DEFAULT_TIMEOUT,
    retries = API_CONFIG.MAX_RETRIES,
    signal = undefined,
    credentials = "same-origin",
    headers: customHeaders = {}
  } = options;

  const url = buildUrl(path, query);

  const requestMethod =
    String(method).toUpperCase();

  const serializedBody =
    prepareBody(body);

  let attempt = 0;

  while (true) {
    const controller =
      new AbortController();

    let timeoutId = null;

    const externalSignal = signal;

    const abortHandler = () => {
      controller.abort();
    };

    if (externalSignal) {
      if (externalSignal.aborted) {
        controller.abort();
      } else {
        externalSignal.addEventListener(
          "abort",
          abortHandler,
          { once: true }
        );
      }
    }

    timeoutId = setTimeout(
      () => controller.abort(),
      timeout
    );

    try {
      const response = await fetch(url, {
        method: requestMethod,
        headers: createHeaders({
          method: requestMethod,
          body,
          headers: customHeaders
        }),
        body: serializedBody,
        credentials,
        signal: controller.signal
      });

      const data =
        await parseResponseBody(response);

      const requestId =
        response.headers.get("X-Request-ID") ||
        response.headers.get("CF-Ray") ||
        null;

      if (!response.ok) {
        const retryable =
          isRetryableStatus(response.status);

        if (
          retryable &&
          attempt < retries
        ) {
          attempt += 1;

          const delay =
            API_CONFIG.RETRY_DELAY *
            Math.pow(2, attempt - 1);

          await sleep(delay);
          continue;
        }

        throw new ApiError(
          extractMessage(
            data,
            `HTTP ${response.status}`
          ),
          {
            status: response.status,
            code: extractCode(data),
            details: extractDetails(data),
            data,
            url,
            method: requestMethod,
            requestId,
            retryable
          }
        );
      }

      return {
        ok: true,
        status: response.status,
        statusText: response.statusText,
        data: extractData(data),
        raw: data,
        headers: response.headers,
        requestId
      };

    } catch (error) {
      if (error instanceof ApiError) {
        throw error;
      }

      const aborted =
        error &&
        typeof error === "object" &&
        error.name === "AbortError";

      if (
        !aborted &&
        attempt < retries
      ) {
        attempt += 1;

        const delay =
          API_CONFIG.RETRY_DELAY *
          Math.pow(2, attempt - 1);

        await sleep(delay);
        continue;
      }

      if (aborted) {
        throw new ApiError(
          "Запрос отменён или превышено время ожидания.",
          {
            status: 408,
            code: "REQUEST_TIMEOUT",
            url,
            method: requestMethod,
            retryable: false
          }
        );
      }

      throw new ApiError(
        error?.message ||
          "Ошибка соединения с сервером.",
        {
          status: 0,
          code: "NETWORK_ERROR",
          url,
          method: requestMethod,
          retryable: true
        }
      );

    } finally {
      if (timeoutId) {
        clearTimeout(timeoutId);
      }

      if (externalSignal) {
        externalSignal.removeEventListener(
          "abort",
          abortHandler
        );
      }
    }
  }
}


/* ============================================================
   SIMPLE HTTP METHODS
   ============================================================ */

async function get(path, options = {}) {
  return request(path, {
    ...options,
    method: "GET"
  });
}


async function post(path, body = undefined, options = {}) {
  return request(path, {
    ...options,
    method: "POST",
    body
  });
}


async function put(path, body = undefined, options = {}) {
  return request(path, {
    ...options,
    method: "PUT",
    body
  });
}


async function patch(path, body = undefined, options = {}) {
  return request(path, {
    ...options,
    method: "PATCH",
    body
  });
}


async function del(path, options = {}) {
  return request(path, {
    ...options,
    method: "DELETE"
  });
}


async function head(path, options = {}) {
  return request(path, {
    ...options,
    method: "HEAD"
  });
}


/* ============================================================
   DATA SHORTCUTS
   ============================================================ */

async function getData(path, options = {}) {
  const response =
    await get(path, options);

  return response.data;
}


async function postData(
  path,
  body = undefined,
  options = {}
) {
  const response =
    await post(path, body, options);

  return response.data;
}


async function putData(
  path,
  body = undefined,
  options = {}
) {
  const response =
    await put(path, body, options);

  return response.data;
}


async function patchData(
  path,
  body = undefined,
  options = {}
) {
  const response =
    await patch(path, body, options);

  return response.data;
}


async function deleteData(
  path,
  options = {}
) {
  const response =
    await del(path, options);

  return response.data;
}


