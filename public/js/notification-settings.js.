  function createDefaultSettings() {
    const result = {
      version: 1,

      global: {
        enabled: true,

        in_app: true,
        push: true,
        sound: true,
        vibration: true,
        badge: true,
        email: false,
        system_chat: true,

        quiet_hours: {
          enabled: false,
          start: "23:00",
          end: "07:00"
        },

        grouped_delivery: false,

        categories: {}
      },

      categories: {}
    };

    CONFIG.categories.forEach(function (category) {
      result.categories[category.id] = createDefaultCategorySetting();

      category.events.forEach(function (eventId) {
        result.categories[category.id].events[eventId] =
          createDefaultEventSetting();
      });

      result.global.categories[category.id] = {
        enabled: true
      };
    });

    return result;
  }

  function normalizeSettings(input) {
    const defaults = createDefaultSettings();

    if (!isObject(input)) {
      return defaults;
    }

    const source =
      input.settings && isObject(input.settings)
        ? input.settings
        : input;

    const result = Object.assign({}, defaults);

    if (isObject(source.global)) {
      result.global = Object.assign(
        {},
        defaults.global,
        source.global
      );

      if (isObject(source.global.quiet_hours)) {
        result.global.quiet_hours = Object.assign(
          {},
          defaults.global.quiet_hours,
          source.global.quiet_hours
        );
      }
    }

    if (isObject(source.categories)) {
      Object.keys(defaults.categories).forEach(function (categoryId) {
        const defaultCategory =
          defaults.categories[categoryId];

        const incomingCategory =
          source.categories[categoryId];

        if (!isObject(incomingCategory)) {
          result.categories[categoryId] = defaultCategory;
          return;
        }

        result.categories[categoryId] = Object.assign(
          {},
          defaultCategory,
          incomingCategory
        );

        result.categories[categoryId].events = {};

        Object.keys(defaultCategory.events).forEach(function (eventId) {
          result.categories[categoryId].events[eventId] =
            Object.assign(
              {},
              defaultCategory.events[eventId],
              isObject(incomingCategory.events?.[eventId])
                ? incomingCategory.events[eventId]
                : {}
            );
        });
      });
    }

    return result;
  }

  function getCategory(categoryId) {
    return CONFIG.categories.find(function (category) {
      return category.id === categoryId;
    }) || null;
  }

  function getEvent(categoryId, eventId) {
    const category = getCategory(categoryId);

    if (!category) return null;

    return category.events.includes(eventId)
      ? eventId
      : null;
  }

  function getRawEventSetting(
    settings,
    categoryId,
    eventId
  ) {
    const category =
      settings?.categories?.[categoryId];

    return category?.events?.[eventId] || null;
  }

  function resolveMode(
    categoryId,
    eventId,
    channel
  ) {
    const forced =
      state.forced?.categories?.[categoryId]?.events?.[eventId]?.[
        channel
      ];

    if (forced === CONFIG.modes.ALLOW) {
      return CONFIG.modes.ALLOW;
    }

    if (forced === CONFIG.modes.DENY) {
      return CONFIG.modes.DENY;
    }

    const admin =
      state.admin?.categories?.[categoryId]?.events?.[eventId]?.[
        channel
      ];

    if (admin === CONFIG.modes.ALLOW) {
      return CONFIG.modes.ALLOW;
    }

    if (admin === CONFIG.modes.DENY) {
      return CONFIG.modes.DENY;
    }

    const current =
      state.current?.categories?.[categoryId]?.events?.[eventId]?.[
        channel
      ];

    if (current === CONFIG.modes.ALLOW) {
      return CONFIG.modes.ALLOW;
    }

    if (current === CONFIG.modes.DENY) {
      return CONFIG.modes.DENY;
    }

    const global =
      state.global?.categories?.[categoryId]?.events?.[eventId]?.[
        channel
      ];

    if (global === CONFIG.modes.ALLOW) {
      return CONFIG.modes.ALLOW;
    }

    if (global === CONFIG.modes.DENY) {
      return CONFIG.modes.DENY;
    }

    return CONFIG.modes.INHERIT;
  }

  function isLocked(
    categoryId,
    eventId,
    channel
  ) {
    const forced =
      state.forced?.categories?.[categoryId]?.events?.[eventId];

    return Boolean(
      forced?.locked === true ||
      forced?.[channel] === CONFIG.modes.ALLOW ||
      forced?.[channel] === CONFIG.modes.DENY
    );
  }

  function canChange(
    categoryId,
    eventId,
    channel
  ) {
    if (state.mode === "admin" || state.mode === "superadmin") {
      return !isLocked(categoryId, eventId, channel);
    }

    return !isLocked(categoryId, eventId, channel);
  }

  function effectiveEnabled(categoryId, eventId) {
    const event =
      state.current?.categories?.[categoryId]?.events?.[eventId];

    if (event?.enabled === false) return false;

    const category =
      state.current?.categories?.[categoryId];

    if (category?.enabled === false) return false;

    if (state.global?.enabled === false) return false;

    return true;
  }

