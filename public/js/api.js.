const filesApi = {

  upload(file, options = {}) {
    const formData = new FormData();

    formData.append(
      options.fieldName || "file",
      file
    );

    if (options.type) {
      formData.append(
        "type",
        options.type
      );
    }

    if (options.targetType) {
      formData.append(
        "target_type",
        options.targetType
      );
    }

    if (options.targetId) {
      formData.append(
        "target_id",
        options.targetId
      );
    }

    return postData(
      "/files/upload",
      formData
    );
  },

  delete(id) {
    return deleteData(
      `/files/${encodeURIComponent(id)}`
    );
  }
};


