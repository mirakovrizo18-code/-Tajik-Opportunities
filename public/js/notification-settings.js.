                <span></span>
              </label>

            </div>

            <div class="to-notification-channels">
              ${channelHtml}
            </div>
          </div>
        `;
      }).join("");

    return `
      <section
        class="to-notification-category"
        data-category-id="${escapeHtml(category.id)}"
      >

        <div class="to-notification-category-header">

          <div class="to-notification-category-icon">
            ${category.icon}
          </div>

          <div class="to-notification-category-info">
            <h3>
              ${escapeHtml(category.name)}
            </h3>

            <p>
              ${escapeHtml(category.description)}
