          data-admin-action="participant"
        >
          👤 Участник
        </button>

        <button
          type="button"
          data-admin-action="force"
        >
          🔒 Принудительные настройки
        </button>

        <button
          type="button"
          data-admin-action="history"
        >
          📜 История изменений
        </button>

        <button
          type="button"
          data-admin-action="allow-all"
        >
