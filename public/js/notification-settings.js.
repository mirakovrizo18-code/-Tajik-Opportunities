    }

    return request(CONFIG.api.participant, {
      method: "PUT",
      body: JSON.stringify({
        participant_id: participantId,
        settings: settings || state.current
      })
    });
  }

  async function loadHistory(
    participantId,
    options
  ) {
    const query = new URLSearchParams();

    if (participantId) {
      query.set(
        "participant_id",
        participantId
      );
    }

    if (options?.category) {
      query.set(
        "category",
        options.category
      );
    }

    if (options?.event) {
      query.set(
        "event",
        options.event
      );
    }

    const url =
      CONFIG.api.history +
      (query.toString()
        ? "?" + query.toString()
        : "");

    return request(url, {
      method: "GET"
    });
  }

