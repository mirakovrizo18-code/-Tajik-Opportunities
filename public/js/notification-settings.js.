  /* ==========================================================
     ADMIN FORCE
     ========================================================== */

  function setAdminOverride(
    categoryId,
    eventId,
    channel,
    mode,
    options
  ) {
    const opts = options || {};

    if (!state.admin.categories) {
      state.admin.categories = {};
    }

    if (!state.admin.categories[categoryId]) {
      state.admin.categories[categoryId] =
        createDefaultCategorySetting();
    }

    if (!state.admin.categories[categoryId].events[eventId]) {
      state.admin.categories[categoryId].events[eventId] =
        createDefaultEventSetting();
    }

    state.admin.categories[categoryId].events[eventId][channel] =
      normalizeMode(mode);

    if (opts.locked !== undefined) {
      state.admin.categories[categoryId].events[eventId].locked =
        Boolean(opts.locked);
    }

    if (opts.temporary !== undefined) {
      state.admin.categories[categoryId].events[eventId].temporary =
        Boolean(opts.temporary);
    }

    markDirty();

    emit("admin-override-changed", {
      categoryId,
      eventId,
      channel,
      mode,
      options: opts
    });

    return true;
  }

  function setForcedSetting(
    categoryId,
    eventId,
    channel,
    mode,
    options
  ) {
    const opts = options || {};

    if (!state.forced.categories) {
      state.forced.categories = {};
    }

    if (!state.forced.categories[categoryId]) {
      state.forced.categories[categoryId] =
        createDefaultCategorySetting();
    }

    if (!state.forced.categories[categoryId].events[eventId]) {
      state.forced.categories[categoryId].events[eventId] =
        createDefaultEventSetting();
    }

    const event =
      state.forced.categories[categoryId].events[eventId];

    event[channel] =
      normalizeMode(mode);

    event.forced = true;

    if (opts.locked !== undefined) {
      event.locked =
        Boolean(opts.locked);
    }

    if (opts.startsAt !== undefined) {
      event.starts_at =
        opts.startsAt || null;
    }

    if (opts.endsAt !== undefined) {
      event.ends_at =
        opts.endsAt || null;
    }

    emit("forced-setting-changed", {
      categoryId,
      eventId,
      channel,
      mode,
      options: opts
    });

    return true;
  }

  /* ==========================================================
     QUICK ACTIONS
     ========================================================== */

  function allowAll() {
    CONFIG.categories.forEach(function (category) {
      category.events.forEach(function (eventId) {
        CONFIG.channels.forEach(function (channel) {
          setChannel(
            category.id,
            eventId,
            channel,
            CONFIG.modes.ALLOW
          );
        });

        setEventEnabled(
          category.id,
          eventId,
          true
        );
      });

      setCategoryEnabled(
        category.id,
        true
      );
    });

    setGlobalEnabled(true);

    return true;
  }

  function denyAll() {
    CONFIG.categories.forEach(function (category) {
      category.events.forEach(function (eventId) {
        CONFIG.channels.forEach(function (channel) {
          setChannel(
            category.id,
            eventId,
            channel,
            CONFIG.modes.DENY
          );
        });
      });
    });

    return true;
  }

  function inheritAll() {
    CONFIG.categories.forEach(function (category) {
      category.events.forEach(function (eventId) {
        CONFIG.channels.forEach(function (channel) {
          setChannel(
            category.id,
            eventId,
            channel,
            CONFIG.modes.INHERIT
          );
        });
      });
    });

    return true;
  }

  function reset() {
    state.current =
      createDefaultSettings();

    state.dirty = true;

    saveLocal();

    emit("reset");

    return state.current;
  }

  /* ==========================================================
     READ API
     ========================================================== */

  function getSettings() {
    return clone(state.current);
  }

  function getGlobalSettings() {
    return clone(state.global);
  }

  function getAdminSettings() {
    return clone(state.admin);
  }

  function getForcedSettings() {
    return clone(state.forced);
  }

  function getCategorySettings(categoryId) {
    return clone(
      state.current.categories?.[categoryId] ||
      null
    );
  }

  function getEventSettings(
    categoryId,
    eventId
  ) {
    return clone(
      getRawEventSetting(
        state.current,
        categoryId,
        eventId
      )
    );
  }

  function getEffectiveChannel(
    categoryId,
    eventId,
    channel
  ) {
    return resolveMode(
      categoryId,
      eventId,
      channel
    );
  }

  function isEnabled(
    categoryId,
    eventId
  ) {
    return effectiveEnabled(
      categoryId,
      eventId
    );
  }

  function isChannelEnabled(
    categoryId,
    eventId,
    channel
  ) {
    const mode =
      resolveMode(
        categoryId,
        eventId,
        channel
      );

    if (mode === CONFIG.modes.DENY) {
      return false;
    }

    if (mode === CONFIG.modes.ALLOW) {
      return true;
    }

    return true;
  }

  /* ==========================================================
